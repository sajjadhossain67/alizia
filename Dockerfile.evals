# ALIZIA AI - Evaluation Subsystem Docker Runner
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Default: execute evaluation harness
ENTRYPOINT ["python", "-m", "ai.evals.cli"]
CMD ["run", "--model", "alizia-nova", "--output", "docs/evals/baseline.md"]
